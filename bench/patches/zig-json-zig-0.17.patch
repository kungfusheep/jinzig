+
+/// zig 0.17 compat: rebuilds the pre-0.17 `Struct.fields` list from field_names/field_types/field_attrs.
+fn CompatField(comptime FieldType: type) type {
+    return struct {
+        name: [:0]const u8,
+        type: type = FieldType,
+        is_comptime: bool,
+        default_value_ptr: ?*const anyopaque,
+
+        pub fn defaultValue(comptime f: @This()) ?FieldType {
+            const dp: *const FieldType = @ptrCast(@alignCast(f.default_value_ptr orelse return null));
+            return dp.*;
+        }
+    };
+}
+
+fn fieldsOf(comptime info: std.builtin.Type.Struct) FieldTuple(info) {
+    var out: FieldTuple(info) = undefined;
+    inline for (info.field_names, info.field_types, info.field_attrs, 0..) |n, t, a, i| {
+        out[i] = CompatField(t){ .name = n, .is_comptime = a.@"comptime", .default_value_ptr = a.default_value_ptr };
+    }
+    return out;
+}
+
+fn FieldTuple(comptime info: std.builtin.Type.Struct) type {
+    var types: [info.field_types.len]type = undefined;
+    for (&types, info.field_types) |*t, ft| t.* = CompatField(ft);
+    return @Tuple(&types);
+}
