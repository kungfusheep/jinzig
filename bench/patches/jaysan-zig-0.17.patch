 const std = @import("std");
 
+// zig 0.17 compat: rebuilds the pre-0.17 field list from field_names/field_types
+const Field = struct { name: [:0]const u8, type: type };
+
+inline fn fieldList(comptime T: type) []const Field {
+    comptime {
+        const info = switch (@typeInfo(T)) {
+            .@"struct" => |i| .{ i.field_names, i.field_types },
+            .@"union" => |i| .{ i.field_names, i.field_types },
+            else => unreachable,
+        };
+        var out: [info[0].len]Field = undefined;
+        for (&out, info[0], info[1]) |*f, n, t| f.* = .{ .name = n, .type = t };
+        const final = out;
+        return &final;
+    }
+}
