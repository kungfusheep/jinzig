--- a/src/meta.zig
+++ b/src/meta.zig
@@ -27,7 +27,7 @@ pub const JsonConfig = SerdeConfig;
 pub fn hasField(comptime T: type, comptime name: []const u8) bool {
     return switch (@typeInfo(T)) {
         .@"struct" => |info| blk: {
-            inline for (info.fields) |field| {
+            inline for (fieldsOf(info)) |field| {
                 if (std.mem.eql(u8, field.name, name)) break :blk true;
             }
             break :blk false;
@@ -182,3 +182,22 @@ test "case conversion" {
     try std.testing.expectEqualStrings("http_server", applyCase("HTTPServer", .snake_case));
     try std.testing.expectEqualStrings("http-server", applyCase("HTTPServer", .kebab_case));
 }
+
+/// zig 0.17 compat: rebuilds the pre-0.17 `Struct.fields` list from field_names/field_types/field_attrs.
+pub const CompatField = struct {
+    name: [:0]const u8,
+    type: type,
+    is_comptime: bool,
+    default_value_ptr: ?*const anyopaque,
+};
+
+pub inline fn fieldsOf(comptime info: std.builtin.Type.Struct) []const CompatField {
+    comptime {
+        var out: [info.field_names.len]CompatField = undefined;
+        for (&out, info.field_names, info.field_types, info.field_attrs) |*f, n, t, a| {
+            f.* = .{ .name = n, .type = t, .is_comptime = a.@"comptime", .default_value_ptr = a.default_value_ptr };
+        }
+        const final = out;
+        return &final;
+    }
+}
